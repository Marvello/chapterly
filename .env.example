# Copy to .env next to compose.yaml. (Comments on their own lines: compose's .env parser.)
# openssl rand -base64 32
AUTH_SECRET=
# Tower: https://novels.<domain>
AUTH_URL=http://localhost:3000

# Tower only: authentik OIDC. Leave all three empty locally = password login only.
# Issuer looks like https://auth.<domain>/application/o/chapterly/
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME=authentik
# false = OIDC only (needs OIDC configured)
AUTH_PASSWORD_LOGIN=true

# Tower: point at the Audiobookshelf library and its owner
CHAPTERLY_LIBRARY_DIR=./library
# Default: Docker named volume "chapterly-data" (required on Docker Desktop/Mac).
# Linux host (Tower) may use a host path, e.g. /srv/novel/data
# CHAPTERLY_DATA_DIR=chapterly-data
PUID=1000
PGID=1000
