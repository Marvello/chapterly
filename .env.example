# Copy to .env next to compose.yaml. (Comments on their own lines: compose's .env parser.)
# openssl rand -base64 32
AUTH_SECRET=
# The URL you open the UI at, e.g. https://<your host> behind a tunnel / reverse proxy
AUTH_URL=http://localhost:3000

# Optional OIDC login: set all three, or leave all empty = password login only.
# Issuer: your provider's issuer URL, e.g. https://auth.<domain>/...
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
# Label on the sign-in button (default: SSO)
AUTH_OIDC_NAME=
# false = OIDC only (needs OIDC configured)
AUTH_PASSWORD_LOGIN=true

# Point at the Audiobookshelf library, and PUID/PGID at its owner
CHAPTERLY_LIBRARY_DIR=./library
# Default: Docker named volume "chapterly-data" (required on Docker Desktop/Mac).
# A Linux host may use a host path instead, e.g. /path/to/chapterly-data
# CHAPTERLY_DATA_DIR=chapterly-data
PUID=1000
PGID=1000

# Optional: ask Audiobookshelf to rescan the library right after an EPUB is updated (set all three or none).
# Token: ABS → Settings → API Keys, for an ADMIN user (library scans are admin-only).
# ABS on the same host (13378 is ABS's default port):
# CHAPTERLY_ABS_URL=http://host.docker.internal:13378
# CHAPTERLY_ABS_TOKEN=
# CHAPTERLY_ABS_LIBRARY=Ebooks
